@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SoleStride</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="auth-split">
        <div class="auth-brand">
            <div class="auth-brand-content">
                <svg class="auth-brand-icon" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M8 1.314C12.438-3.248 23.534 4.735 8 15-7.534 4.736 3.562-3.248 8 1.314"/>
                </svg>
                <h1 class="auth-brand-title">SoleStride</h1>
                <p class="auth-brand-tagline">Step into style with premium footwear crafted for every journey.</p>
                <div class="auth-brand-features">
                    <div class="auth-brand-feature">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M13.854 3.646a.5.5 0 0 1 0 .708l-7 7a.5.5 0 0 1-.708 0l-3.5-3.5a.5.5 0 1 1 .708-.708L6.5 10.293l6.646-6.647a.5.5 0 0 1 .708 0"/>
                        </svg>
                        <span>Curated collections for every style</span>
                    </div>
                    <div class="auth-brand-feature">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M13.854 3.646a.5.5 0 0 1 0 .708l-7 7a.5.5 0 0 1-.708 0l-3.5-3.5a.5.5 0 1 1 .708-.708L6.5 10.293l6.646-6.647a.5.5 0 0 1 .708 0"/>
                        </svg>
                        <span>Fast & free shipping on orders over $50</span>
                    </div>
                    <div class="auth-brand-feature">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M13.854 3.646a.5.5 0 0 1 0 .708l-7 7a.5.5 0 0 1-.708 0l-3.5-3.5a.5.5 0 1 1 .708-.708L6.5 10.293l6.646-6.647a.5.5 0 0 1 .708 0"/>
                        </svg>
                        <span>Easy 30-day returns, no questions asked</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="auth-form-panel">
            <div class="auth-form-inner">
                <div class="auth-form-header">
                    <a asp-action="Login" class="auth-back-link">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0"/>
                        </svg>
                        Back to Sign In
                    </a>
                    <h1>Forgot Password</h1>
                    <p>Enter your username to reset your password.</p>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="auth-alert">@ViewBag.Error</div>
                }

                <form asp-action="ForgotPassword" method="post">
                    <div class="auth-form-group">
                        <label for="username">Username</label>
                        <input type="text" class="auth-input" id="username" name="username" placeholder="Enter your username" required autofocus />
                    </div>

                    <button type="submit" class="auth-btn">Continue</button>
                </form>

                <div class="auth-footer-text">
                    Remembered your password? <a asp-action="Login">Sign in</a>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
