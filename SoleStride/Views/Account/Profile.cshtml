@model SoleStride.Models.User

@{
    ViewData["Title"] = "My Profile";
}

<div class="mb-4">
    <h1 class="h2 fw-bold mb-1">My Account Profile</h1>
    <p class="text-muted small mb-0">Manage your personal information, address settings, and security</p>
</div>

<!-- Profile Hero Card -->
<div class="profile-hero-card">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-4 position-relative" style="z-index:2;">
        <div class="d-flex align-items-center gap-4 flex-wrap">
            @if (!string.IsNullOrEmpty(Model.AvatarUrl))
            {
                <img src="@Model.AvatarUrl" alt="@Model.Username" class="profile-avatar-large" />
            }
            else
            {
                <div class="profile-avatar-placeholder">
                    @Model.Username.Substring(0, 1).ToUpper()
                </div>
            }

            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <h2 class="h3 fw-bold text-white mb-0">@Model.FirstName @Model.LastName</h2>
                    <span class="badge bg-light text-dark fw-bold" style="font-size:0.75rem;">@Model.Role</span>
                </div>
                <div class="text-light opacity-75 mb-2">@@@Model.Username</div>
                <div class="d-flex gap-2 flex-wrap">
                    <span class="badge bg-white bg-opacity-10 text-white border border-light border-opacity-25">Member Verified</span>
                    <span class="badge bg-white bg-opacity-10 text-white border border-light border-opacity-25">SoleStride Club</span>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="EditProfile" class="btn-brand">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168z"/>
                </svg>
                <span>Edit Profile</span>
            </a>
            <a asp-controller="Order" asp-action="Index" class="btn-brand-outline text-white border-light">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M8 1.314C12.438-3.248 23.534 4.735 8 15-7.534 4.736 3.562-3.248 8 1.314"/>
                </svg>
                <span>View My Orders</span>
            </a>
        </div>
    </div>
</div>

<!-- Personal Details Grid -->
<div class="row g-4">
    <div class="col-lg-8">
        <div class="card-custom p-4">
            <h3 class="h5 fw-bold mb-3 pb-2 border-bottom">Personal Information</h3>

            <div class="row g-3">
                <div class="col-md-6">
                    <div class="info-tile">
                        <div class="info-tile-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M3 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1zm5-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6"/>
                            </svg>
                        </div>
                        <div>
                            <span class="text-muted small d-block">Username</span>
                            <span class="fw-bold text-dark">@Model.Username</span>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="info-tile">
                        <div class="info-tile-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1zm13 2.383-4.708 2.825L15 11.105zm-.034 6.876-5.64-3.471L8 9.583l-1.326-.795-5.64 3.47A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.741M1 11.105l4.708-2.897L1 5.383z"/>
                            </svg>
                        </div>
                        <div>
                            <span class="text-muted small d-block">Email Address</span>
                            <span class="fw-bold text-dark">@(Model.EmailAddress ?? "Not specified")</span>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="info-tile">
                        <div class="info-tile-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M3.654 1.328a.678.678 0 0 0-1.015-.063L1.605 2.3c-.483.484-.661 1.169-.45 1.77a17.6 17.6 0 0 0 4.168 6.608 17.6 17.6 0 0 0 6.608 4.168c.601.211 1.286.033 1.77-.45l1.034-1.034a.678.678 0 0 0-.063-1.015l-2.307-1.794a.68.68 0 0 0-.58-.122l-2.19.547a1.75 1.75 0 0 1-1.657-.459L5.482 8.062a1.75 1.75 0 0 1-.46-1.657l.548-2.19a.68.68 0 0 0-.122-.58z"/>
                            </svg>
                        </div>
                        <div>
                            <span class="text-muted small d-block">Phone Number</span>
                            <span class="fw-bold text-dark">@(Model.Phone ?? "Not specified")</span>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="info-tile">
                        <div class="info-tile-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6m2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0m4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4m-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10s-3.516.68-4.168 1.332c-.678.678-.83 1.418-.832 1.664z"/>
                            </svg>
                        </div>
                        <div>
                            <span class="text-muted small d-block">Gender</span>
                            <span class="fw-bold text-dark">@Model.UserGender</span>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="info-tile">
                        <div class="info-tile-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5M1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4z"/>
                            </svg>
                        </div>
                        <div>
                            <span class="text-muted small d-block">Birthdate</span>
                            <span class="fw-bold text-dark">@Model.Birthdate.ToString("MMMM dd, yyyy")</span>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="info-tile">
                        <div class="info-tile-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M8 0c-.69 0-1.843.265-2.928.56-1.11.3-2.229.655-2.887.87a1.54 1.54 0 0 0-1.044 1.262c-.596 4.477.787 7.795 2.464 9.99 1.579 2.065 3.48 3.018 4.395 3.317a1.6 1.6 0 0 0 1.054 0c.915-.299 2.816-1.252 4.395-3.317 1.677-2.195 3.06-5.513 2.464-9.99a1.54 1.54 0 0 0-1.044-1.263 63 63 0 0 0-2.887-.87C9.843.266 8.69 0 8 0"/>
                            </svg>
                        </div>
                        <div>
                            <span class="text-muted small d-block">Account Role</span>
                            <span class="fw-bold text-dark">@Model.Role</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Shortcuts Sidebar -->
    <div class="col-lg-4">
        <div class="card-custom p-4 mb-4">
            <h3 class="h6 fw-bold mb-3">Quick Actions</h3>
            <div class="d-flex flex-column gap-2">
                <a asp-action="EditProfile" class="btn btn-brand-outline justify-content-start">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168z"/>
                    </svg>
                    <span>Update Profile Information</span>
                </a>
                <a asp-action="EditProfile" asp-fragment="changePassword" class="btn btn-brand-outline justify-content-start">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2zm3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/>
                    </svg>
                    <span>Change Password</span>
                </a>
                <a asp-controller="Order" asp-action="Index" class="btn btn-brand-outline justify-content-start">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M0 1.5A.5.5 0 0 1 .5 1H2a.5.5 0 0 1 .485.379L2.89 3H14.5a.5.5 0 0 1 .491.592l-1.5 8A.5.5 0 0 1 13 12H4a.5.5 0 0 1-.491-.408L2.01 3.607 1.61 2H.5a.5.5 0 0 1-.5-.5"/>
                    </svg>
                    <span>My Past Orders</span>
                </a>
            </div>
        </div>

        <div class="card-custom p-4 bg-light border-0">
            <h4 class="h6 fw-bold mb-2">Need Assistance?</h4>
            <p class="text-muted small mb-3">Our customer support specialists are ready to help with orders, exchanges, and sizing.</p>
            <a href="mailto:support@solestride.com" class="btn btn-sm btn-dark-brand w-100">Contact Support</a>
        </div>
    </div>
</div>
