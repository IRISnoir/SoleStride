@model SoleStride.Models.Shoes

@{
    ViewData["Title"] = "Delete Shoes";
}

<div class="delete-card">
    <div class="delete-header">
        <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16">
            <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
            <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
        </svg>
        <h2>Delete Shoe</h2>
    </div>
    <div class="delete-body">
        <p class="delete-description">Are you sure you want to delete this product? This action cannot be undone.</p>

        <div class="detail-row">
            <span class="detail-label">Shoes Name</span>
            <span class="detail-value">@Model.ShoesName</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">SKU</span>
            <span class="detail-value">@(Model.SkuId ?? "-")</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Category</span>
            <span class="detail-value">@(Model.Category?.CategoryName ?? Model.CategoryId)</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Gender</span>
            <span class="detail-value">@Model.ShoesGender</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Size</span>
            <span class="detail-value">@Model.ShoesSize</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Color</span>
            <span class="detail-value">@Model.ShoesColor</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Material</span>
            <span class="detail-value">@Model.Material</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Price</span>
            <span class="detail-value">$@Model.Price.ToString("F2")</span>
        </div>
        @if (Model.SalePercentage.HasValue && Model.SalePercentage > 0)
        {
            <div class="detail-row">
                <span class="detail-label">Sale</span>
                <span class="detail-value">@Model.SalePercentage.Value%</span>
            </div>
        }

        <form asp-action="Delete" class="d-flex gap-2 mt-4 pt-3" style="border-top:1px solid #f1f3f5;">
            <input type="hidden" asp-for="ProductId" />
            <button type="submit" class="btn btn-danger-custom">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash3 me-1" viewBox="0 0 16 16">
                    <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
                    <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
                </svg>
                Delete Shoe
            </button>
            <a asp-action="Index" class="btn btn-back-custom">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8"/>
                </svg>
                Cancel
            </a>
        </form>
    </div>
</div>