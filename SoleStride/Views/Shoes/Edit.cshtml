@model SoleStride.Models.Shoes

@{
    ViewData["Title"] = "Edit Shoe";
}

<div class="page-header">
    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 16 16" style="color:#6c757d;">
        <path d="M15.502 1.94a.5.5 0 0 1 0 .706l-1.5 1.5a.5.5 0 0 1-.707 0l-1.5-1.5a.5.5 0 0 1 .707-.708L14.5 2.793V4.5a.5.5 0 0 1-.5.5h-1.5a.5.5 0 0 1-.5-.5V2.793l-1.146 1.147a.5.5 0 1 1-.708-.708l1.5-1.5a.5.5 0 0 1 .707 0l1.5 1.5a.5.5 0 0 1-.707.708L13.5 2.207V4.5a.5.5 0 0 1-.5.5h-1.5a.5.5 0 0 1-.5-.5V2.793l-1.146 1.147a.5.5 0 0 1-.708-.708l1.5-1.5a.5.5 0 0 1 .707 0l1.5 1.5a.5.5 0 0 1-.707.708L11.5 2.207V4.5a.5.5 0 0 1-.5.5h-1.5a.5.5 0 0 1-.5-.5V2.793l-1.146 1.147a.5.5 0 0 1-.708-.708l1.5-1.5a.5.5 0 0 1 .707 0l1.5 1.5a.5.5 0 0 1-.707.708L8.5 2.207V4.5a.5.5 0 0 1-.5.5h-1.5a.5.5 0 0 1-.5-.5V2.793l-1.146 1.147a.5.5 0 0 1-.708-.708l1.5-1.5a.5.5 0 0 1 .707 0l1.5 1.5a.5.5 0 0 1-.707.708L5.5 2.207V4.5a.5.5 0 0 1-.5.5h-1.5a.5.5 0 0 1-.5-.5V2.793l-1.146 1.147a.5.5 0 0 1-.708-.708l1.5-1.5a.5.5 0 0 1 .707 0l1.5 1.5a.5.5 0 0 1-.707.708L2.5 2.207V4.5a.5.5 0 0 1-.5.5h-1.5a.5.5 0 0 1-.5-.5V2.793l-1.146 1.147a.5.5 0 0 1-.708-.708l1.5-1.5a.5.5 0 0 1 .707 0l1.5 1.5a.5.5 0 0 1-.707.708L0 2.207V4.5a1.5 1.5 0 0 0 1.5 1.5h13a1.5 1.5 0 0 0 1.5-1.5V2.793a.5.5 0 0 1 1 0V15a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 0 15V2a.5.5 0 0 1 .5-.5V1.94z"/>
    </svg>
    <h1>Edit Shoe</h1>
</div>
<p class="page-subtitle">Update the product details below.</p>

<div class="form-card">
    <form asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="text-danger-custom"></div>
        <input type="hidden" asp-for="ProductId" />

        <div class="form-section">
            <div class="form-section-title">Product Information</div>
            <div class="form-row">
                <div class="mb-3">
                    <label asp-for="ShoesName" class="form-label-custom"></label>
                    <input asp-for="ShoesName" class="form-control form-control-custom" />
                    <span asp-validation-for="ShoesName" class="text-danger-custom"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="SkuId" class="form-label-custom"></label>
                    <input asp-for="SkuId" class="form-control form-control-custom" />
                    <span asp-validation-for="SkuId" class="text-danger-custom"></span>
                </div>
            </div>
            <div class="form-row">
                <div class="mb-3">
                    <label asp-for="CategoryId" class="form-label-custom"></label>
                    <input asp-for="CategoryId" class="form-control form-control-custom" />
                    <span asp-validation-for="CategoryId" class="text-danger-custom"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ShoesGender" class="form-label-custom"></label>
                    <input asp-for="ShoesGender" class="form-control form-control-custom" />
                    <span asp-validation-for="ShoesGender" class="text-danger-custom"></span>
                </div>
            </div>
            <div class="form-row">
                <div class="mb-3">
                    <label asp-for="ShoesSize" class="form-label-custom"></label>
                    <input asp-for="ShoesSize" class="form-control form-control-custom" />
                    <span asp-validation-for="ShoesSize" class="text-danger-custom"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ShoesColor" class="form-label-custom"></label>
                    <input asp-for="ShoesColor" class="form-control form-control-custom" />
                    <span asp-validation-for="ShoesColor" class="text-danger-custom"></span>
                </div>
            </div>
        </div>

        <div class="form-section">
            <div class="form-section-title">Additional Details</div>
            <div class="form-row">
                <div class="mb-3">
                    <label asp-for="Material" class="form-label-custom"></label>
                    <input asp-for="Material" class="form-control form-control-custom" />
                    <span asp-validation-for="Material" class="text-danger-custom"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Price" class="form-label-custom"></label>
                    <input asp-for="Price" class="form-control form-control-custom" />
                    <span asp-validation-for="Price" class="text-danger-custom"></span>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="SalePercentage" class="form-label-custom"></label>
                <input asp-for="SalePercentage" class="form-control form-control-custom" />
                <span asp-validation-for="SalePercentage" class="text-danger-custom"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label-custom"></label>
                <input asp-for="Description" class="form-control form-control-custom" />
                <span asp-validation-for="Description" class="text-danger-custom"></span>
            </div>
        </div>

        <div class="d-flex gap-2 mt-4 pt-3" style="border-top:1px solid #f1f3f5;">
            <button type="submit" class="btn btn-submit">Save Changes</button>
            <a asp-action="Index" class="btn btn-back">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8"/>
                </svg>
                Back to List
            </a>
        </div>
    </form>
</div>