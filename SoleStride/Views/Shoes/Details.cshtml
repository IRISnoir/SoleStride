@model SoleStride.Models.Shoes

@{
    ViewData["Title"] = Model.ShoesName;
    var salePrice = Model.SalePercentage.HasValue && Model.SalePercentage > 0
        ? Model.Price * (decimal)(1 - Model.SalePercentage.Value / 100)
        : Model.Price;
}

<div class="page-header">
    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 16 16" style="color:#6c757d;">
        <path d="M2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2zm5.354 4.646a.5.5 0 1 1-.708.708L5.5 4.207V7.5a.5.5 0 0 1-1 0V4.207l-1.146 1.147a.5.5 0 1 1-.708-.708l2-2a.5.5 0 0 1 .708 0zM6.5 11.793V9.5a.5.5 0 0 1 1 0v2.293l1.146-1.147a.5.5 0 0 1 .708.708l-2 2a.5.5 0 0 1-.708 0l-2-2a.5.5 0 0 1 .708-.708zm3.646-4.147a.5.5 0 0 1 0-.708l2-2a.5.5 0 0 1 .708.708L11.207 6.5H12.5a.5.5 0 0 1 0 1h-1.293l1.147 1.146a.5.5 0 0 1-.708.708z"/>
    </svg>
    <h1>@Model.ShoesName</h1>
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="form-card">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="@Model.ShoesName" style="width:100%;border-radius:12px;" />
            }
            else
            {
                <div style="width:100%;height:300px;background:#f1f3f5;border-radius:12px;display:flex;align-items:center;justify-content:center;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="#adb5bd" viewBox="0 0 16 16">
                        <path d="M6.002 5.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0"/>
                        <path d="M2.002 1a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V3a2 2 0 0 0-2-2zm12 1a1 1 0 0 1 1 1v6.5l-3-3-2.5 3-1-1.5-4 5h12z"/>
                    </svg>
                </div>
            }
        </div>
    </div>
    <div class="col-lg-7">
        <div class="form-card">
            <div class="form-section">
                <div class="form-section-title">Product Details</div>
                <div class="detail-row">
                    <span class="detail-label">Category</span>
                    <span class="detail-value">@(Model.Category?.CategoryName ?? Model.CategoryId)</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Gender</span>
                    <span class="detail-value">@Model.ShoesGender</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Size</span>
                    <span class="detail-value">@Model.ShoesSize</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Color</span>
                    <span class="detail-value">@Model.ShoesColor</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Material</span>
                    <span class="detail-value">@Model.Material</span>
                </div>
                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <div class="detail-row">
                        <span class="detail-label">Description</span>
                        <span class="detail-value">@Model.Description</span>
                    </div>
                }
                <div class="detail-row">
                    <span class="detail-label">Price</span>
                    <span class="detail-value">
                        @if (Model.SalePercentage.HasValue && Model.SalePercentage > 0)
                        {
                            <span class="text-decoration-line-through text-muted me-1">$@Model.Price.ToString("F2")</span>
                            <span class="text-danger fw-bold fs-5">$@salePrice.ToString("F2")</span>
                            <span class="badge bg-danger ms-2">-@Model.SalePercentage.Value%</span>
                        }
                        else
                        {
                            <span class="fw-bold fs-5">$@Model.Price.ToString("F2")</span>
                        }
                    </span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">SKU</span>
                    <span class="detail-value">@(Model.SkuId ?? "-")</span>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4 pt-3" style="border-top:1px solid #f1f3f5;">
                <form asp-controller="Cart" asp-action="AddToCart" method="post">
                    <input type="hidden" name="productId" value="@Model.ProductId" />
                    <input type="hidden" name="quantity" value="1" />
                    <button type="submit" class="btn btn-submit">Add to Cart</button>
                </form>
                <a asp-controller="Home" asp-action="Index" class="btn btn-back">Back to Catalog</a>
            </div>
        </div>
    </div>
</div>
