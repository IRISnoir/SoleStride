@model SoleStride.Models.Shoes

@{
    ViewData["Title"] = "Shoe Details";
    var salePrice = Model.SalePercentage.HasValue && Model.SalePercentage > 0
        ? Model.Price * (decimal)(1 - Model.SalePercentage.Value / 100)
        : Model.Price;
}

<div class="shoes-detail container-fluid">
    <div class="page-header">
        <h1 class="shoes-title">@Model.ShoesName</h1>
        <div class="product-category-pill">@(Model.Category?.CategoryName ?? Model.CategoryId.ToString())</div>
    </div>

    <div class="row g-4 align-items-start">
        <div class="col-lg-6">
            <div class="image-card">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <div class="image-wrapper">
                        <img src="@Model.ImageUrl" alt="@Model.ShoesName" class="detail-image" />
                    </div>
                }
                else
                {
                    <div class="image-placeholder">
                        <svg xmlns="http://www.w3.org/2000/svg" width="96" height="96" fill="#adb5bd" viewBox="0 0 16 16">
                            <path d="M6.002 5.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0"/>
                            <path d="M2.002 1a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V3a2 2 0 0 0-2-2zm12 1a1 1 0 0 1 1 1v6.5l-3-3-2.5 3-1-1.5-4 5h12z"/>
                        </svg>
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-6">
            <div class="form-card detail-info">
                <div class="form-section">
                    <div class="form-section-title">Product Details</div>

                    <div class="detail-row">
                        <span class="detail-label">Category</span>
                        <span class="detail-value">@(Model.Category?.CategoryName ?? Model.CategoryId)</span>
                    </div>

                    <div class="detail-row">
                        <span class="detail-label">Gender</span>
                        <span class="detail-value">@Model.ShoesGender</span>
                    </div>

                    <div class="detail-row">
                        <span class="detail-label">Size</span>
                        <span class="detail-value">@Model.ShoesSize</span>
                    </div>

                    <div class="detail-row">
                        <span class="detail-label">Color</span>
                        <span class="detail-value">@Model.ShoesColor</span>
                    </div>

                    <div class="detail-row">
                        <span class="detail-label">Material</span>
                        <span class="detail-value">@Model.Material</span>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <div class="detail-row">
                            <span class="detail-label">Description</span>
                            <span class="detail-value">@Model.Description</span>
                        </div>
                    }

                    <div class="detail-row price-row">
                        <span class="detail-label">Price</span>
                        <span class="detail-value">
                            @if (Model.SalePercentage.HasValue && Model.SalePercentage > 0)
                            {
                                <span class="price-original">$@Model.Price.ToString("F2")</span>
                                <span class="price-large">$@salePrice.ToString("F2")</span>
                                <span class="sale-percent">(-@Model.SalePercentage.Value%)</span>
                            }
                            else
                            {
                                <span class="price-large">$@Model.Price.ToString("F2")</span>
                            }
                        </span>
                    </div>

                    <div class="detail-row">
                        <span class="detail-label">SKU</span>
                        <span class="detail-value">@(Model.SkuId ?? "-")</span>
                    </div>
                </div>

                <div class="actions mt-4">
                    <form asp-controller="Cart" asp-action="AddToCart" method="post" class="d-inline">
                        <input type="hidden" name="productId" value="@Model.ProductId" />
                        <input type="hidden" name="quantity" value="1" />
                        <button type="submit" class="btn btn-primary btn-add-cart">Add to Cart</button>
                    </form>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-back ms-3">Back to Shoe Collection</a>
                </div>
            </div>
        </div>
    </div>
</div>
