@model IEnumerable<SoleStride.Models.HomeProductViewModel>

@{
    ViewData["Title"] = "Shoe Collection";
    var categories = ViewBag.Categories as List<SoleStride.Models.Category>;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h1 class="h2 mb-0">Shoe Collection</h1>
    @if (Context.Session.GetString("Role") == "Staff" || Context.Session.GetString("Role") == "Admin")
    {
        <div class="d-flex gap-2">
            <a asp-controller="Shoes" asp-action="Create" class="btn btn-primary">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-lg me-1" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2"/>
                </svg>
                Add Product
            </a>
            @if (Context.Session.GetString("Role") == "Admin")
            {
                <a asp-controller="Category" asp-action="Create" class="btn btn-outline-secondary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-folder-plus me-1" viewBox="0 0 16 16">
                        <path d="m.5 3 .04.87a1.99 1.99 0 0 0 .342 1.311l.561 2.286a1 1 0 0 0 .95.684h11.34a1 1 0 0 0 .95-.684l.561-2.285a1.99 1.99 0 0 0 .342-1.31L13.5 3zM2 4.665v3.718a2 2 0 0 0 .5 1.311l5.15 2.66A2 2 0 0 0 9 13.133h7.5v-2.618a2 2 0 0 0-.5-1.311L9.35 6.685A2 2 0 0 0 8.5 4.665L2 4.665zM7.5 13.133a2 2 0 0 0 1.311-.5l5.15-2.66A2 2 0 0 0 14 10.383V4.665L7.5 8.18V13.133z"/>
                    </svg>
                    Category
                </a>
            }
        </div>
    }
</div>

<div class="filter-card mb-4">
    <form asp-controller="Home" asp-action="Index" method="get" class="filter-form">
        <div class="filter-grid">
            <div class="filter-field">
                <label for="categoryId" class="form-label-custom">Category</label>
                <select name="categoryId" id="categoryId" class="form-control form-control-custom">
                    <option value="">All Categories</option>
                    @if (categories != null)
                    {
                        foreach (var cat in categories)
                        {
                            <option value="@cat.CategoryId" selected="@(ViewBag.SelectedCategoryId == cat.CategoryId)">@cat.CategoryName</option>
                        }
                    }
                </select>
            </div>

            <div class="filter-field">
                <label for="gender" class="form-label-custom">Gender</label>
                <select name="gender" id="gender" class="form-control form-control-custom">
                    <option value="">All</option>
                    <option value="Men" selected="@(ViewBag.SelectedGender == "Men")">Men</option>
                    <option value="Women" selected="@(ViewBag.SelectedGender == "Women")">Women</option>
                    <option value="Unisex" selected="@(ViewBag.SelectedGender == "Unisex")">Unisex</option>
                </select>
            </div>

            <div class="filter-field">
                <label for="minSize" class="form-label-custom">Size (min - max)</label>
                <div class="d-flex align-items-center gap-1">
                    <input type="number" name="minSize" id="minSize" class="form-control form-control-custom" min="1" max="50" placeholder="Min" value="@ViewBag.MinSize" />
                    <span class="text-muted">-</span>
                    <input type="number" name="maxSize" id="maxSize" class="form-control form-control-custom" min="1" max="50" placeholder="Max" value="@ViewBag.MaxSize" />
                </div>
            </div>

            <div class="filter-field">
                <label for="color" class="form-label-custom">Color</label>
                <input type="text" name="color" id="color" class="form-control form-control-custom" placeholder="e.g. Black, Red" value="@ViewBag.SelectedColor" />
            </div>

            <div class="filter-field">
                <label for="minPrice" class="form-label-custom">Price (min - max)</label>
                <div class="d-flex align-items-center gap-1">
                    <input type="number" name="minPrice" id="minPrice" class="form-control form-control-custom" min="0" step="0.01" placeholder="Min $" value="@ViewBag.MinPrice" />
                    <span class="text-muted">-</span>
                    <input type="number" name="maxPrice" id="maxPrice" class="form-control form-control-custom" min="0" step="0.01" placeholder="Max $" value="@ViewBag.MaxPrice" />
                </div>
            </div>

            <div class="filter-field">
                <label for="sortBy" class="form-label-custom">Sort by</label>
                <select name="sortBy" id="sortBy" class="form-control form-control-custom">
                    <option value="name_asc" selected="@(ViewBag.SortBy == "name_asc")">Name (A-Z)</option>
                    <option value="name_desc" selected="@(ViewBag.SortBy == "name_desc")">Name (Z-A)</option>
                    <option value="price_asc" selected="@(ViewBag.SortBy == "price_asc")">Price (Low to High)</option>
                    <option value="price_desc" selected="@(ViewBag.SortBy == "price_desc")">Price (High to Low)</option>
                    <option value="newest" selected="@(ViewBag.SortBy == "newest")">Newest</option>
                </select>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2 filter-actions mt-3">
            <label class="filter-checkbox d-flex align-items-center gap-2 mb-0">
                <input type="checkbox" name="onSale" value="true" checked="@(ViewBag.OnSale == true)" />
                <span>On sale only</span>
            </label>
            <button type="submit" class="btn btn-submit">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="me-1" viewBox="0 0 16 16">
                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0"/>
                </svg>
                Apply Filters
            </button>
            <a asp-controller="Home" asp-action="Index" class="btn btn-back">Clear</a>
        </div>
    </form>
</div>

@if (!Model.Any())
{
    <div class="catalogue-empty">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007ZM8.625 10.5a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
        </svg>
        <h3>No shoes available</h3>
        <p class="text-muted mb-0">Check back soon for new arrivals.</p>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
        @foreach (var item in Model)
        {
            var salePrice = item.Shoes.SalePercentage.HasValue && item.Shoes.SalePercentage > 0
                ? item.Shoes.Price * (decimal)(1 - item.Shoes.SalePercentage.Value / 100)
                : item.Shoes.Price;

            <div class="col">
                <div class="card product-card h-100" data-details-url="@Url.Action("Details", "Shoes", new { id = item.Shoes.ProductId })">
                    <div class="card-img-wrapper">
                        @if (!string.IsNullOrEmpty(item.Shoes.ImageUrl))
                        {
                            <img src="@item.Shoes.ImageUrl" alt="@item.Shoes.ShoesName" loading="lazy" />
                        }
                        else
                        {
                            <div class="card-img-placeholder">
                                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" class="placeholder-img" viewBox="0 0 16 16">
                                    <path d="M6.002 5.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0"/>
                                    <path d="M2.002 1a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V3a2 2 0 0 0-2-2zm12 1a1 1 0 0 1 1 1v6.5l-3-3-2.5 3-1-1.5-4 5h12z"/>
                                </svg>
                            </div>
                        }
                        <div class="badge-overlay">
                            <span class="badge bg-dark bg-opacity-75 text-white">@(item.Shoes.Category?.CategoryName ?? "N/A")</span>
                        </div>
                        @if (item.Shoes.SalePercentage.HasValue && item.Shoes.SalePercentage > 0)
                        {
                            <span class="badge-sale badge">-@item.Shoes.SalePercentage.Value%</span>
                        }
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="product-name mb-0">@item.Shoes.ShoesName</h5>
                            <span class="badge gender-badge bg-light text-dark border">@item.Shoes.ShoesGender</span>
                        </div>
                        @if (!string.IsNullOrEmpty(item.Shoes.Description))
                        {
                            <p class="product-description text-muted small mb-3">@item.Shoes.Description</p>
                        }

                        @if (Context.Session.GetString("Role") == "Staff" || Context.Session.GetString("Role") == "Admin")
                        {
                            <div class="staff-info">
                                <span class="staff-chip">
                                    <span class="chip-label">ID</span>
                                    <span class="chip-value">@item.Shoes.ProductId</span>
                                </span>
                                <span class="staff-chip">
                                    <span class="chip-label">SKU</span>
                                    <span class="chip-value">@item.Shoes.SkuId</span>
                                </span>
                                <span class="staff-chip">
                                    <span class="chip-label">Category</span>
                                    <span class="chip-value">@item.Shoes.CategoryId</span>
                                </span>
                            </div>
                        }

                        <!-- Stock Display in Product Card -->
                        <div class="product-card-stock">
                            <div class="stock-mini stock-available" title="Available in stock">
                                <span class="stock-icon">Available </span>
                                <span class="stock-count">@item.QuantityAvailable</span>
                            </div>
                            <div class="stock-mini stock-sold" title="Sold units">
                                <span class="stock-icon">Sold </span>
                                <span class="stock-count">@item.QuantitySold ✓</span>
                            </div>
                        </div>

                        <div class="price-section">
                            @if (item.Shoes.SalePercentage.HasValue && item.Shoes.SalePercentage > 0)
                            {
                                <span class="price-original">$@item.Shoes.Price.ToString("F2")</span>
                                <span class="price-sale">$@salePrice.ToString("F2")</span>
                            }
                            else
                            {
                                <span class="price-regular">$@item.Shoes.Price.ToString("F2")</span>
                            }
                        </div>
                        <div class="d-flex gap-2 mt-2">
                            <form asp-controller="Cart" asp-action="AddToCart" method="post" class="flex-fill" onclick="event.stopPropagation()">
                                <input type="hidden" name="productId" value="@item.Shoes.ProductId" />
                                <input type="hidden" name="quantity" value="1" />
                                <button type="submit" class="btn btn-submit btn-view w-100" style="white-space:nowrap;">Add to Cart</button>
                            </form>
                        </div>
                    </div>
                    @if (Context.Session.GetString("Role") == "Staff" || Context.Session.GetString("Role") == "Admin")
                    {
                        <div class="card-footer-admin" onclick="event.stopPropagation()">
                            <div class="d-flex gap-2">
                                <a asp-controller="Shoes" asp-action="Edit" asp-route-id="@item.Shoes.ProductId" class="btn btn-sm btn-outline-primary flex-fill">Edit</a>
                                @if (Context.Session.GetString("Role") == "Admin")
                                {
                                    <a asp-controller="Shoes" asp-action="Delete" asp-route-id="@item.Shoes.ProductId" class="btn btn-sm btn-outline-danger flex-fill">Delete</a>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

@section Scripts {
    <script>
        document.querySelectorAll('.product-card').forEach(function(card) {
            card.addEventListener('click', function(e) {
                if (e.target.closest('button, a, form, input, select, textarea')) {
                    return;
                }
                const url = card.getAttribute('data-details-url');
                if (url) {
                    window.location.href = url;
                }
            });
        });
    </script>
}
