@model IEnumerable<SoleStride.Models.HomeProductViewModel>

@{
    ViewData["Title"] = "Search Results";
    var query = Context.Request.Query["query"].ToString();
    var userRole = Context.Session.GetString("Role");
}

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-1" style="font-size:0.88rem;">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-muted">Home</a></li>
            <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">Search Results</li>
        </ol>
    </nav>
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h1 class="h2 fw-bold mb-1">
                Search Results @(string.IsNullOrEmpty(query) ? "" : $"for \"{query}\"")
            </h1>
            <p class="text-muted small mb-0">Found @Model.Count() products matching your search</p>
        </div>
        <a asp-controller="Shoes" asp-action="Index" class="btn-brand-outline">
            View All Shoes
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card-custom text-center py-5 px-3">
        <div class="mb-3 text-muted">
            <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.2">
                <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
            </svg>
        </div>
        <h3 class="h4 fw-bold">No Shoes Matched Your Search</h3>
        <p class="text-muted mb-4">We couldn't find any footwear matching "<strong>@query</strong>". Try another keyword or browse our entire catalogue.</p>
        <a asp-controller="Home" asp-action="Index" class="btn-brand mx-auto">Explore Trending Sneakers</a>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        @foreach (var item in Model)
        {
            var salePrice = item.Shoes.SalePercentage.HasValue && item.Shoes.SalePercentage > 0
                ? item.Shoes.Price * (decimal)(1 - item.Shoes.SalePercentage.Value / 100)
                : item.Shoes.Price;

            <div class="col">
                <div class="product-card" data-details-url="@Url.Action("Details", "Shoes", new { id = item.Shoes.ProductId })">
                    <div class="card-img-wrapper">
                        @if (!string.IsNullOrEmpty(item.Shoes.ImageUrl))
                        {
                            <img src="@item.Shoes.ImageUrl" alt="@item.Shoes.ShoesName" loading="lazy" />
                        }
                        else
                        {
                            <div class="card-img-placeholder">
                                <svg xmlns="http://www.w3.org/2000/svg" width="42" height="42" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M1.5 9.5c.4-.3.9-.5 1.4-.5h1.2c.3 0 .6-.1.8-.3l1.6-1.5c.3-.3.7-.4 1.1-.3l1.1.3c.4.1.7.4.8.8l.3 1c.1.3.4.5.7.5h2c1 0 2 .5 2.6 1.3.2.3.4.5.7.6l.7.3c.3.1.5.4.5.7v.7c0 .4-.3.7-.7.7H2c-.6 0-1-.4-1-1v-2c0-.5.2-1 .5-1.3z" />
                                </svg>
                                <span>No Image</span>
                            </div>
                        }

                        <span class="badge-category-tag">@(item.Shoes.Category?.CategoryName ?? "Footwear")</span>

                        @if (item.Shoes.SalePercentage.HasValue && item.Shoes.SalePercentage > 0)
                        {
                            <span class="badge-sale-tag">-@item.Shoes.SalePercentage.Value%</span>
                        }
                    </div>

                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="product-gender-badge">@item.Shoes.ShoesGender</span>
                            <span class="text-muted small">Size: @item.Shoes.ShoesSize</span>
                        </div>

                        <h3 class="product-name" title="@item.Shoes.ShoesName">@item.Shoes.ShoesName</h3>

                        @if (!string.IsNullOrEmpty(item.Shoes.Description))
                        {
                            <p class="product-description">@item.Shoes.Description</p>
                        }

                        <div class="product-stock-bar">
                            <div class="stock-pill available" title="In Stock">
                                <span>@item.QuantityAvailable in stock</span>
                            </div>
                            <div class="stock-pill sold ms-auto" title="Sold units">
                                <span>@item.QuantitySold sold</span>
                            </div>
                        </div>

                        <div class="price-section">
                            @if (item.Shoes.SalePercentage.HasValue && item.Shoes.SalePercentage > 0)
                            {
                                <span class="price-sale">$@salePrice.ToString("F2")</span>
                                <span class="price-original">$@item.Shoes.Price.ToString("F2")</span>
                            }
                            else
                            {
                                <span class="price-regular">$@item.Shoes.Price.ToString("F2")</span>
                            }
                        </div>

                        <form asp-controller="Cart" asp-action="AddToCart" method="post" onclick="event.stopPropagation()">
                            <input type="hidden" name="productId" value="@item.Shoes.ProductId" />
                            <input type="hidden" name="quantity" value="1" />
                            <button type="submit" class="btn-card-cart">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M0 1.5A.5.5 0 0 1 .5 1H2a.5.5 0 0 1 .485.379L2.89 3H14.5a.5.5 0 0 1 .491.592l-1.5 8A.5.5 0 0 1 13 12H4a.5.5 0 0 1-.491-.408L2.01 3.607 1.61 2H.5a.5.5 0 0 1-.5-.5M3.102 4l1.313 7h8.17l1.313-7zM5 12a2 2 0 1 0 0 4 2 2 0 0 0 0-4m7 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4m-7 1a1 1 0 1 1 0 2 1 1 0 0 1 0-2m7 0a1 1 0 1 1 0 2 1 1 0 0 1 0-2"/>
                                </svg>
                                <span>Add to Cart</span>
                            </button>
                        </form>
                    </div>

                    @if (userRole == "Staff" || userRole == "Admin")
                    {
                        <div class="card-footer-admin" onclick="event.stopPropagation()">
                            <div class="d-flex gap-2">
                                <a asp-controller="Shoes" asp-action="Edit" asp-route-id="@item.Shoes.ProductId" class="btn btn-sm btn-outline-secondary flex-fill">Edit</a>
                                @if (userRole == "Admin")
                                {
                                    <a asp-controller="Shoes" asp-action="Delete" asp-route-id="@item.Shoes.ProductId" class="btn btn-sm btn-outline-danger flex-fill">Delete</a>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

@section Scripts {
    <script>
        document.querySelectorAll('.product-card').forEach(function(card) {
            card.addEventListener('click', function(e) {
                if (e.target.closest('button, a, form, input, select, textarea')) {
                    return;
                }
                const url = card.getAttribute('data-details-url');
                if (url) {
                    window.location.href = url;
                }
            });
        });
    </script>
}
