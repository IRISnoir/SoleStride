@model IEnumerable<SoleStride.Models.Shoes>

@{
    ViewData["Title"] = "Search Results";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <div class="page-header">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 16 16" style="color:#6c757d;">
                <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0"/>
            </svg>
            <h1>Search Results</h1>
        </div>
        <p class="page-subtitle">@Model.Count() result(s) for "@ViewBag.Query"</p>
    </div>
    <a asp-controller="Home" asp-action="Index" class="btn btn-back">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8"/>
        </svg>
        Back to Catalog
    </a>
</div>

@if (!Model.Any())
{
    <div class="catalogue-empty">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
        </svg>
        <h3>No results found</h3>
        <p class="text-muted mb-0">Try searching with different keywords.</p>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
        @foreach (var item in Model)
        {
            var salePrice = item.SalePercentage.HasValue && item.SalePercentage > 0
                ? item.Price * (decimal)(1 - item.SalePercentage.Value / 100)
                : item.Price;

            <div class="col">
                <div class="card product-card h-100">
                    <div class="card-img-wrapper">
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" alt="@item.ShoesName" loading="lazy" />
                        }
                        else
                        {
                            <div class="card-img-placeholder">
                                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M6.002 5.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0"/>
                                    <path d="M2.002 1a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V3a2 2 0 0 0-2-2zm12 1a1 1 0 0 1 1 1v6.5l-3-3-2.5 3-1-1.5-4 5h12z"/>
                                </svg>
                            </div>
                        }
                        <div class="badge-overlay">
                            <span class="badge bg-dark bg-opacity-75 text-white">@(item.Category?.CategoryName ?? "N/A")</span>
                        </div>
                        @if (item.SalePercentage.HasValue && item.SalePercentage > 0)
                        {
                            <span class="badge-sale badge">-@item.SalePercentage.Value%</span>
                        }
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="product-name mb-0">@item.ShoesName</h5>
                            <span class="badge gender-badge bg-light text-dark border">@item.ShoesGender</span>
                        </div>
                        <p class="product-description text-muted small mb-3">@item.Description</p>
                        <div class="price-section">
                            @if (item.SalePercentage.HasValue && item.SalePercentage > 0)
                            {
                                <span class="price-original">$@item.Price.ToString("F2")</span>
                                <span class="price-sale">$@salePrice.ToString("F2")</span>
                            }
                            else
                            {
                                <span class="price-regular">$@item.Price.ToString("F2")</span>
                            }
                        </div>
                        <div class="d-flex gap-2 mt-2">
                            <a asp-controller="Shoes" asp-action="Details" asp-route-id="@item.ProductId" class="btn btn-dark btn-view flex-fill">View Details</a>
                            <form asp-controller="Cart" asp-action="AddToCart" method="post" style="display:inline;">
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <input type="hidden" name="quantity" value="1" />
                                <button type="submit" class="btn btn-submit" style="white-space:nowrap;">Add to Cart</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
