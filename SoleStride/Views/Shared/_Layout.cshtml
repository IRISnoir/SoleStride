                            <div class="footer-store-info">
                                <div class="footer-heading">Visit our store</div>
                                <h5>@footerStore.StoreName</h5>
                                <p class="text-secondary small mb-2">@footerStore.Address</p>
                                <p class="text-secondary small mb-2">Phone: @footerStore.Phone</p>
                                @if (!string.IsNullOrWhiteSpace(footerStore.OpeningHours))
                                {
                                    <p class="text-secondary small mb-3">Hours: @footerStore.OpeningHours</p>
                                }
                                <a href="https://www.google.com/maps/dir/?api=1&amp;destination=@Uri.EscapeDataString(footerStore.Address)"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="footer-store-link d-inline-block mb-2">
                                    Get directions on Google Maps
                                </a>
                                <br />
                            </div>
                        </div>
                        <div class="col-lg-8">
                            <div id="footerStoreMap" class="footer-store-map" aria-label="Store location map"></div>
                        </div>
                    </div>
                }

                <div class="footer-bottom">
                    <div>&copy; @DateTime.Now.Year SoleStride Footwear Inc. All rights reserved.</div>
