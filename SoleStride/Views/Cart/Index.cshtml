@model List<SoleStride.Models.CartItem>

@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="page-header">
    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 16 16" style="color:#6c757d;">
        <path d="M0 1.5A.5.5 0 0 1 .5 1H2a.5.5 0 0 1 .485.379L2.89 3H14.5a.5.5 0 0 1 .491.592l-1.5 8A.5.5 0 0 1 13 12H4a.5.5 0 0 1-.491-.408L2.01 3.607 1.61 2H.5a.5.5 0 0 1-.5-.5M3.102 4l1.313 7h8.17l1.313-7zM5 12a2 2 0 1 0 0 4 2 2 0 0 0 0-4m7 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4m-7 1a1 1 0 1 1 0 2 1 1 0 0 1 0-2m7 0a1 1 0 1 1 0 2 1 1 0 0 1 0-2"/>
    </svg>
    <h1>Shopping Cart</h1>
</div>

@if (TempData["CartMessage"] != null)
{
    <div class="alert alert-success alert-custom">@TempData["CartMessage"]</div>
}

@if (!Model.Any())
{
    <div class="form-card text-center py-5">
        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="#adb5bd" viewBox="0 0 16 16">
            <path d="M0 1.5A.5.5 0 0 1 .5 1H2a.5.5 0 0 1 .485.379L2.89 3H14.5a.5.5 0 0 1 .491.592l-1.5 8A.5.5 0 0 1 13 12H4a.5.5 0 0 1-.491-.408L2.01 3.607 1.61 2H.5a.5.5 0 0 1-.5-.5M3.102 4l1.313 7h8.17l1.313-7zM5 12a2 2 0 1 0 0 4 2 2 0 0 0 0-4m7 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4m-7 1a1 1 0 1 1 0 2 1 1 0 0 1 0-2m7 0a1 1 0 1 1 0 2 1 1 0 0 1 0-2"/>
        </svg>
        <h5 class="mt-3 text-muted">Your cart is empty</h5>
        <a asp-controller="Home" asp-action="Index" class="btn btn-submit mt-3">Continue Shopping</a>
    </div>
}
else
{
    <div class="table-custom">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Price</th>
                    <th>Quantity</th>
                    <th>Subtotal</th>
                    <th style="width:80px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" alt="@item.ShoesName" style="width:48px;height:48px;object-fit:cover;border-radius:8px;" />
                                }
                                else
                                {
                                    <div style="width:48px;height:48px;background:#f1f3f5;border-radius:8px;"></div>
                                }
                                <div>
                                    <div class="fw-medium">@item.ShoesName</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            @if (item.SalePercentage > 0)
                            {
                                <span class="text-decoration-line-through text-muted me-1">$@item.Price.ToString("F2")</span>
                                <span class="text-danger fw-bold">$@item.FinalPrice.ToString("F2")</span>
                            }
                            else
                            {
                                <span>$@item.Price.ToString("F2")</span>
                            }
                        </td>
                        <td>
                            <form asp-action="UpdateQuantity" method="post" class="d-flex align-items-center gap-2">
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <input type="number" name="quantity" value="@item.Quantity" min="1" class="form-control form-control-custom" style="width:70px;" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Update</button>
                            </form>
                        </td>
                        <td class="fw-bold">$@item.Subtotal.ToString("F2")</td>
                        <td>
                            <form asp-action="Remove" method="post">
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <button type="submit" class="btn-delete-sm">Remove</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-4">
        <div class="h4 mb-0">Total: <strong>$@Model.Sum(i => i.Subtotal).ToString("F2")</strong></div>
        <div class="d-flex gap-2">
            <a asp-controller="Home" asp-action="Index" class="btn btn-back">Continue Shopping</a>
            <a asp-controller="Checkout" asp-action="Index" class="btn btn-submit">Proceed to Checkout</a>
        </div>
    </div>
}
