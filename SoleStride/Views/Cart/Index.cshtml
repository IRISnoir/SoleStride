@model List<SoleStride.Models.CartItem>

@{
    ViewData["Title"] = "Shopping Cart";
    var totalAmount = Model?.Sum(i => i.Subtotal) ?? 0;
}

<div class="mb-4">
    <h1 class="h2 fw-bold mb-1">Shopping Cart</h1>
    <p class="text-muted small mb-0">Review your selected sneakers before proceeding to checkout</p>
</div>

@if (TempData["CartMessage"] != null)
{
    <div class="alert alert-success d-flex align-items-center gap-2 mb-4" role="alert" style="border-radius:var(--radius-md);">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
            <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0m-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
        </svg>
        <div>@TempData["CartMessage"]</div>
    </div>
}

@if (Model == null || !Model.Any())
{
    <div class="card-custom text-center py-5 px-3">
        <div class="mb-3 text-muted">
            <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" />
            </svg>
        </div>
        <h3 class="h4 fw-bold">Your Cart is Currently Empty</h3>
        <p class="text-muted mb-4">Looks like you haven't added any shoes to your bag yet.</p>
        <a asp-controller="Home" asp-action="Index" class="btn-brand mx-auto">
            <span>Explore Trending Shoes</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                <path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8"/>
            </svg>
        </a>
    </div>
}
else
{
    <div class="row g-4 align-items-start">
        <!-- 1. Left Column: Cart Items List -->
        <div class="col-lg-8">
            <!-- Free Shipping Notice -->
            <div class="free-shipping-card">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M0 3.5A1.5 1.5 0 0 1 1.5 2h9A1.5 1.5 0 0 1 12 3.5V5h1.02a1.5 1.5 0 0 1 1.17.563l1.481 1.85a1.5 1.5 0 0 1 .329.938V10.5a1.5 1.5 0 0 1-1.5 1.5H14a2 2 0 1 1-4 0H5a2 2 0 1 1-4 0H.5a.5.5 0 0 1-.5-.5v-7z"/>
                </svg>
                <span><strong>Special Offer:</strong> Your cart qualifies for <strong>Free Express Shipping</strong> anywhere in the country!</span>
            </div>

            <!-- Items Table Card -->
            <div class="cart-table-card">
                <div class="table-responsive">
                    <table class="cart-table">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Price</th>
                                <th>Quantity</th>
                                <th>Subtotal</th>
                                <th style="width: 50px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                                            {
                                                <img src="@item.ImageUrl" alt="@item.ShoesName" class="cart-product-thumb" />
                                            }
                                            else
                                            {
                                                <div class="cart-product-thumb d-flex align-items-center justify-content-center text-muted">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                                                        <path d="M1.5 9.5c.4-.3.9-.5 1.4-.5h1.2c.3 0 .6-.1.8-.3l1.6-1.5c.3-.3.7-.4 1.1-.3l1.1.3c.4.1.7.4.8.8l.3 1c.1.3.4.5.7.5h2c1 0 2 .5 2.6 1.3.2.3.4.5.7.6l.7.3c.3.1.5.4.5.7v.7c0 .4-.3.7-.7.7H2c-.6 0-1-.4-1-1v-2c0-.5.2-1 .5-1.3z" />
                                                    </svg>
                                                </div>
                                            }
                                            <div>
                                                <a asp-controller="Shoes" asp-action="Details" asp-route-id="@item.ProductId" class="cart-product-name d-block">
                                                    @item.ShoesName
                                                </a>
                                                <span class="text-muted small">Item ID: #@item.ProductId</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @if (item.SalePercentage > 0)
                                        {
                                            <div class="text-danger fw-bold">$@item.FinalPrice.ToString("F2")</div>
                                            <div class="text-muted text-decoration-line-through small">$@item.Price.ToString("F2")</div>
                                        }
                                        else
                                        {
                                            <div class="fw-bold text-dark">$@item.Price.ToString("F2")</div>
                                        }
                                    </td>
                                    <td>
                                        <form asp-action="UpdateQuantity" method="post" class="d-flex align-items-center">
                                            <input type="hidden" name="productId" value="@item.ProductId" />
                                            <div class="qty-stepper-box">
                                                <button type="button" class="qty-step-btn qty-minus">−</button>
                                                <input type="number" name="quantity" value="@item.Quantity" min="1" max="99" 
                                                       class="qty-step-input cart-qty-input" 
                                                       data-price="@item.FinalPrice" 
                                                       onchange="updateCartRow(this)" />
                                                <button type="button" class="qty-step-btn qty-plus">+</button>
                                            </div>
                                        </form>
                                    </td>
                                    <td>
                                        <span class="fw-bold cart-subtotal text-dark" data-price="@item.FinalPrice">
                                            $@item.Subtotal.ToString("F2")
                                        </span>
                                    </td>
                                    <td>
                                        <form asp-action="Remove" method="post">
                                            <input type="hidden" name="productId" value="@item.ProductId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger p-1 rounded-circle" title="Remove this product" style="width:32px;height:32px;display:inline-flex;align-items:center;justify-content:center;">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                                    <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
                                                    <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
                                                </svg>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="mt-3">
                <a asp-controller="Home" asp-action="Index" class="btn-brand-outline">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                        <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8"/>
                    </svg>
                    <span>Continue Shopping</span>
                </a>
            </div>
        </div>

        <!-- 2. Right Column: Sticky Order Summary -->
        <div class="col-lg-4">
            <div class="order-summary-card">
                <h2 class="order-summary-title">Order Summary</h2>

                <div class="summary-row">
                    <span>Items Subtotal (@Model.Sum(i => i.Quantity) items)</span>
                    <span id="cartSubtotalText">$@totalAmount.ToString("F2")</span>
                </div>

                <div class="summary-row">
                    <span>Estimated Shipping</span>
                    <span class="text-success fw-bold">FREE</span>
                </div>

                <div class="summary-row">
                    <span>Tax Estimate</span>
                    <span>$0.00</span>
                </div>

                <div class="summary-row total">
                    <span>Total Amount</span>
                    <span id="cartGrandTotal">$@totalAmount.ToString("F2")</span>
                </div>

                <div class="mt-4">
                    <a asp-controller="Checkout" asp-action="Index" class="btn-brand w-100 justify-content-center" style="padding:0.8rem 1.5rem; font-size:1.05rem;">
                        <span>Proceed to Checkout</span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8"/>
                        </svg>
                    </a>
                </div>

                <div class="mt-3 p-3 bg-light rounded text-center small text-muted">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="me-1" viewBox="0 0 16 16">
                        <path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2zm3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/>
                    </svg>
                    Guaranteed Safe & Secure Checkout
                </div>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            function updateCartRow(input) {
                const row = input.closest('tr');
                const qty = parseInt(input.value) || 1;
                const price = parseFloat(input.dataset.price) || 0;
                const subtotalCell = row.querySelector('.cart-subtotal');
                const subtotal = qty * price;
                subtotalCell.textContent = '$' + subtotal.toFixed(2);
                updateGrandTotal();
                input.form.submit();
            }

            function updateGrandTotal() {
                let total = 0;
                document.querySelectorAll('.cart-subtotal').forEach(function(cell) {
                    total += parseFloat(cell.textContent.replace('$', '')) || 0;
                });
                const formatted = '$' + total.toFixed(2);
                const grandTotalEl = document.getElementById('cartGrandTotal');
                const subtotalTextEl = document.getElementById('cartSubtotalText');
                if (grandTotalEl) grandTotalEl.textContent = formatted;
                if (subtotalTextEl) subtotalTextEl.textContent = formatted;
            }
        </script>
    }
}
