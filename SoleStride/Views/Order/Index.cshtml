@model IEnumerable<SoleStride.Models.Order>

@{
    ViewData["Title"] = "Order History";
    var role = Context.Session.GetString("Role");
}

<div class="mb-4">
    <h1 class="h2 fw-bold mb-1">@(role == "Admin" || role == "Staff" ? "All Customer Orders" : "My Orders")</h1>
    <p class="text-muted small mb-0">Track and review all footwear purchases and shipment statuses</p>
</div>

@if (TempData["OrderSuccess"] != null)
{
    <div class="alert alert-success d-flex align-items-center gap-2 mb-4" role="alert" style="border-radius:var(--radius-md);">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
            <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0m-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
        </svg>
        <div>@TempData["OrderSuccess"]</div>
    </div>
}

@if (!Model.Any())
{
    <div class="card-custom text-center py-5 px-3">
        <div class="mb-3 text-muted">
            <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
            </svg>
        </div>
        <h3 class="h4 fw-bold">No Orders Placed Yet</h3>
        <p class="text-muted mb-4">You haven't completed any shoe purchases yet. Start shopping now!</p>
        <a asp-controller="Home" asp-action="Index" class="btn-brand mx-auto">
            <span>Explore Shoe Collection</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                <path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8"/>
            </svg>
        </a>
    </div>
}
else
{
    <div class="card-custom">
        <div class="table-responsive">
            <table class="cart-table">
                <thead>
                    <tr>
                        <th>Order ID</th>
                        <th>Date & Time</th>
                        <th>Receiver</th>
                        <th>Total Amount</th>
                        <th>Shipment Status</th>
                        <th style="width: 120px;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var badgeClass = item.Status switch
                        {
                            "Delivered" => "bg-success text-white",
                            "Shipped" => "bg-info text-white",
                            "Processing" => "bg-primary text-white",
                            "Cancelled" => "bg-danger text-white",
                            _ => "bg-warning text-dark"
                        };

                        <tr>
                            <td>
                                <span class="fw-bold text-dark">#@item.OrderId</span>
                            </td>
                            <td>
                                <span class="text-muted small">@item.OrderDate.ToString("MMM dd, yyyy HH:mm")</span>
                            </td>
                            <td>
                                <span class="fw-semibold text-dark">@(item.ReceiverName ?? item.Username)</span>
                            </td>
                            <td>
                                <span class="fw-bold text-dark">$@item.TotalAmount.ToString("F2")</span>
                            </td>
                            <td>
                                <span class="badge @badgeClass px-2 py-1" style="font-size:0.75rem; border-radius:var(--radius-full);">
                                    @item.Status
                                </span>
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.OrderId" class="btn btn-sm btn-brand-outline py-1 px-3" style="font-size:0.8rem;">
                                    View Details
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
