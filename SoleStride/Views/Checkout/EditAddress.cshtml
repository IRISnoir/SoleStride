@model SoleStride.Models.Address

@{
    ViewData["Title"] = "Edit Address";
}

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-1" style="font-size:0.88rem;">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-muted">Checkout</a></li>
            <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">Edit Address</li>
        </ol>
    </nav>
    <h1 class="h3 fw-bold mb-0">Edit Shipping Address</h1>
</div>

@if (TempData["AddressError"] != null)
{
    <div class="alert alert-danger py-2 small mb-4" style="border-radius:var(--radius-md);">
        @TempData["AddressError"]
    </div>
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card-custom p-4 p-md-5">
            <h2 class="h5 fw-bold mb-1">Update Address Information</h2>
            <p class="text-muted small mb-4">Edit your delivery contact and location details.</p>

            <form asp-action="EditAddress" asp-route-id="@Model.AddressId" method="post">
                @Html.AntiForgeryToken()

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label-custom">Recipient Full Name</label>
                        <input name="recipientName" value="@Model.RecipientName" class="form-control-custom" required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label-custom">Phone Number</label>
                        <input name="phone" value="@Model.Phone" class="form-control-custom" required />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label-custom">Street Address & Apartment / Suite</label>
                    <textarea name="addressLine" class="form-control-custom" rows="3" required>@Model.AddressLine</textarea>
                </div>

                <div class="form-check mb-4">
                    <input type="checkbox" name="isDefault" value="true" class="form-check-input" style="accent-color:var(--accent);" @(Model.IsDefault ? "checked" : "") />
                    <label class="form-check-label fw-semibold text-dark small cursor-pointer">
                        Set this as my default shipping address
                    </label>
                </div>

                <div class="d-flex align-items-center gap-2 pt-3 border-top">
                    <button type="submit" class="btn-brand">
                        <span>Save Changes</span>
                    </button>
                    <a asp-action="Index" class="btn-brand-outline">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
