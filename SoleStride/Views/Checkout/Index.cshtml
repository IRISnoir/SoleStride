@model List<SoleStride.Models.CartItem>

@{
    ViewData["Title"] = "Secure Checkout";
    var addresses = ViewBag.Addresses as List<SoleStride.Models.Address> ?? new List<SoleStride.Models.Address>();
    var totalAmount = Model?.Sum(i => i.Subtotal) ?? 0;
}

<!-- Checkout Stepper Header -->
<div class="checkout-stepper">
    <div class="checkout-step completed">
        <span class="step-num">✓</span>
        <span>Cart</span>
    </div>
    <div class="step-divider"></div>
    <div class="checkout-step active">
        <span class="step-num">2</span>
        <span>Delivery & Payment</span>
    </div>
    <div class="step-divider"></div>
    <div class="checkout-step">
        <span class="step-num">3</span>
        <span>Confirmation</span>
    </div>
</div>

<div class="mb-4">
    <h1 class="h2 fw-bold mb-1">Checkout</h1>
    <p class="text-muted small mb-0">Select your delivery destination and confirm your order details</p>
</div>

@if (TempData["CheckoutError"] != null)
{
    <div class="alert alert-danger d-flex align-items-center gap-2 mb-4" role="alert" style="border-radius:var(--radius-md);">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
            <path d="M7.938 2.016A.13.13 0 0 1 8.002 2a.13.13 0 0 1 .063.016.15.15 0 0 1 .054.057l6.857 11.667c.036.06.035.124.002.183a.2.2 0 0 1-.054.06.1.1 0 0 1-.066.017H1.146a.1.1 0 0 1-.066-.017.2.2 0 0 1-.054-.06.18.18 0 0 1 .002-.183L7.884 2.073a.15.15 0 0 1 .054-.057zm1.044-.45a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767z"/>
            <path d="M7.002 12a1 1 0 1 1 2 0 1 1 0 0 1-2 0M7.1 5.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0z"/>
        </svg>
        <div>@TempData["CheckoutError"]</div>
    </div>
}

@if (TempData["AddressSuccess"] != null)
{
    <div class="alert alert-success d-flex align-items-center gap-2 mb-4" role="alert" style="border-radius:var(--radius-md);">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
            <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0m-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
        </svg>
        <div>@TempData["AddressSuccess"]</div>
    </div>
}

<div class="row g-4 align-items-start">
    <!-- ================= LEFT COLUMN: ADDRESS SELECTOR ================= -->
    <div class="col-lg-7">
        <div class="card-custom p-4 mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                <div>
                    <h2 class="h5 fw-bold mb-0">1. Delivery Address</h2>
                    <span class="text-muted small">Choose your shipping destination</span>
                </div>
                <a asp-controller="Checkout" asp-action="CreateAddress" class="btn btn-sm btn-brand" style="padding:0.4rem 1rem;">
                    + Add New Address
                </a>
            </div>

            @if (!addresses.Any())
            {
                <div class="alert alert-warning py-3" style="border-radius:var(--radius-md);">
                    <strong>No saved addresses found.</strong> Please click <strong>"+ Add New Address"</strong> above before completing your order.
                </div>
            }
            else
            {
                <form id="placeOrderForm" asp-controller="Checkout" asp-action="PlaceOrder" method="post">
                    @Html.AntiForgeryToken()

                    <!-- Hidden inputs populated dynamically via script -->
                    <input type="hidden" id="shippingAddress" name="shippingAddress" />
                    <input type="hidden" id="phone" name="phone" />

                    <div class="address-list mb-3">
                        @foreach (var address in addresses)
                        {
                            <div class="address-card-item @(address.IsDefault ? "selected" : "")" onclick="selectAddressCard(this)">
                                <div class="d-flex align-items-start gap-3">
                                    <div class="pt-1">
                                        <input type="radio" 
                                               name="addressId" 
                                               value="@address.AddressId" 
                                               class="form-check-input address-radio" 
                                               data-address="@address.AddressLine" 
                                               data-phone="@address.Phone" 
                                               style="accent-color:var(--accent); width:20px; height:20px;"
                                               @(address.IsDefault ? "checked" : "") />
                                    </div>

                                    <div class="flex-grow-1">
                                        <div class="address-card-header">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="address-recipient">@address.RecipientName</span>
                                                @if (address.IsDefault)
                                                {
                                                    <span class="badge-default-addr">Default Address</span>
                                                }
                                            </div>

                                            <div class="d-flex gap-1" onclick="event.stopPropagation()">
                                                <a asp-controller="Checkout" asp-action="EditAddress" asp-route-id="@address.AddressId" class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size:0.75rem;">
                                                    Edit
                                                </a>
                                                <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2" style="font-size:0.75rem;" onclick="deleteAddress(@address.AddressId)">
                                                    Delete
                                                </button>
                                            </div>
                                        </div>

                                        <div class="text-secondary small mb-1">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="me-1 text-muted" viewBox="0 0 16 16">
                                                <path d="M3.654 1.328a.678.678 0 0 0-1.015-.063L1.605 2.3c-.483.484-.661 1.169-.45 1.77a17.6 17.6 0 0 0 4.168 6.608 17.6 17.6 0 0 0 6.608 4.168c.601.211 1.286.033 1.77-.45l1.034-1.034a.678.678 0 0 0-.063-1.015l-2.307-1.794a.68.68 0 0 0-.58-.122l-2.19.547a1.75 1.75 0 0 1-1.657-.459L5.482 8.062a1.75 1.75 0 0 1-.46-1.657l.548-2.19a.68.68 0 0 0-.122-.58z"/>
                                            </svg>
                                            Phone: <strong>@address.Phone</strong>
                                        </div>

                                        <div class="text-dark small">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="me-1 text-muted" viewBox="0 0 16 16">
                                                <path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10m0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6"/>
                                            </svg>
                                            Address: @address.AddressLine
                                        </div>

                                        @if (!address.IsDefault)
                                        {
                                            <div class="mt-2" onclick="event.stopPropagation()">
                                                <button type="button" class="btn btn-sm btn-link p-0 text-decoration-none small" onclick="setDefaultAddress(@address.AddressId)">
                                                    ★ Set as Default Shipping Address
                                                </button>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="d-flex align-items-center gap-2 mt-4">
                        <button type="submit" class="btn-brand flex-grow-1" style="padding:0.75rem 1.5rem; font-size:1rem;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2zm3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/>
                            </svg>
                            <span>Confirm & Place Order</span>
                        </button>

                        <a asp-controller="Cart" asp-action="Index" class="btn-brand-outline">
                            Back to Cart
                        </a>
                    </div>
                </form>
            }
        </div>
    </div>

    <!-- ================= RIGHT COLUMN: ORDER SUMMARY & NOTES ================= -->
    <div class="col-lg-5">
        <div class="order-summary-card mb-4">
            <h2 class="order-summary-title">Order Items (@(Model?.Sum(i => i.Quantity) ?? 0))</h2>

            <div class="checkout-items-list mb-3" style="max-height:300px; overflow-y:auto; padding-right:5px;">
                @foreach (var item in Model)
                {
                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                        <div class="d-flex align-items-center gap-2">
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" alt="@item.ShoesName" style="width:42px;height:42px;object-fit:cover;border-radius:8px;border:1px solid var(--border);" />
                            }
                            <div>
                                <div class="fw-bold small text-dark">@item.ShoesName</div>
                                <span class="text-muted small">Qty: @item.Quantity × $@item.FinalPrice.ToString("F2")</span>
                            </div>
                        </div>
                        <span class="fw-bold small text-dark">$@item.Subtotal.ToString("F2")</span>
                    </div>
                }
            </div>

            <div class="summary-row">
                <span>Shipping Delivery</span>
                <span class="text-success fw-bold">FREE EXPRESS</span>
            </div>

            <div class="summary-row total">
                <span>Total Due</span>
                <span>$@totalAmount.ToString("F2")</span>
            </div>
        </div>

        <!-- Order Note Box -->
        <div class="card-custom p-4">
            <h3 class="h6 fw-bold mb-2">Order Note (Optional)</h3>
            <p class="text-muted small mb-2">Any special delivery instructions, gate code, or preferences?</p>
            <textarea name="customerNote" form="placeOrderForm" class="form-control form-control-custom" rows="3" placeholder="e.g. Leave package at front door, call before delivery..."></textarea>
        </div>
    </div>
</div>

<!-- Hidden Helper Forms for Address Management -->
<form id="deleteAddressForm" asp-controller="Checkout" asp-action="DeleteAddress" method="post" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" id="deleteAddressId" name="id" />
</form>

<form id="defaultAddressForm" asp-controller="Checkout" asp-action="SetDefaultAddress" method="post" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" id="defaultAddressId" name="id" />
</form>

@section Scripts {
    <script>
        function selectAddressCard(element) {
            document.querySelectorAll('.address-card-item').forEach(c => c.classList.remove('selected'));
            element.classList.add('selected');
            const radio = element.querySelector('.address-radio');
            if (radio) {
                radio.checked = true;
                document.getElementById('shippingAddress').value = radio.dataset.address;
                document.getElementById('phone').value = radio.dataset.phone;
            }
        }

        // Address Radio Event Binding
        document.querySelectorAll(".address-radio").forEach(function(radio) {
            radio.addEventListener("change", function() {
                document.getElementById("shippingAddress").value = this.dataset.address;
                document.getElementById("phone").value = this.dataset.phone;
            });
        });

        // Initialize default selected address values
        document.addEventListener("DOMContentLoaded", function() {
            const selected = document.querySelector(".address-radio:checked");
            if (selected) {
                document.getElementById("shippingAddress").value = selected.dataset.address;
                document.getElementById("phone").value = selected.dataset.phone;
            }
        });

        // Address Actions
        function deleteAddress(id) {
            if (confirm("Are you sure you want to delete this shipping address?")) {
                document.getElementById("deleteAddressId").value = id;
                document.getElementById("deleteAddressForm").submit();
            }
        }

        function setDefaultAddress(id) {
            document.getElementById("defaultAddressId").value = id;
            document.getElementById("defaultAddressForm").submit();
        }
    </script>
}
